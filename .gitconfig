[user]
  name = Daniel Chromik
  email = dchromik@redhat.com
	signingkey = /home/dchromik/.ssh/github_signing_ed25519

[core]
  pager = delta
  excludesFile = ~/.gitignore
  editor = nvim

[merge]
  tool = nvimdiff2

[diff]
  tool = nvimdiff

[delta]
  line-numbers = true
  syntax-theme = "GitHub"
  navigate = true
  light = true

[gpg]
	format = ssh

[commit]
	gpgsign = true
	signOff = true

[gpg "ssh"]
	allowedSignersFile = /home/dchromik/.ssh/allowed_signers
